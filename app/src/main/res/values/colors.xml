<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ══════════════════════════════════════════════════════════════════
         Tema warna: teal (primary) + oranye (accent/secondary) + indigo
         (tertiary, dikhususkan utk kategori Pulsa/Transaksi).
         Nama resource lama (ios_*) dipertahankan supaya seluruh layout/kode
         yang sudah ada tidak perlu diubah, cuma NILAI warnanya yang ganti.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Brand utama -->
    <color name="brand_primary">#1B7A62</color>
    <color name="brand_primary_dark">#0E4E3E</color>
    <color name="brand_primary_container">#C0EFE0</color>
    <color name="brand_on_primary">#FFFFFF</color>
    <color name="brand_on_primary_container">#00201A</color>

    <color name="brand_accent">#D97B3A</color>
    <color name="brand_accent_container">#FFE0C4</color>
    <color name="brand_on_accent">#FFFFFF</color>

    <!-- Tertiary: dikhususkan utk elemen kategori Pulsa/Transaksi -->
    <color name="brand_tertiary">#5E5CE6</color>
    <color name="brand_tertiary_container">#E3E2FF</color>
    <color name="brand_on_tertiary">#FFFFFF</color>
    <color name="brand_on_tertiary_container">#0E0066</color>

    <!-- Alias lama (ios_*) supaya seluruh layout/kode existing tetap
         jalan tanpa perubahan, cuma repoint ke warna brand baru -->
    <color name="ios_blue">#1B7A62</color>
    <color name="ios_blue_dark">#1B7A62</color>
    <color name="ios_orange">#D97B3A</color>
    <color name="ios_gray">#899E98</color>
    <color name="ios_green">#1B7A62</color>
    <color name="ios_green_dark">#1B7A62</color>
    <color name="ios_red">#FF3B30</color>
    <color name="ios_red_dark">#FF453A</color>

    <!-- Light surfaces -->
    <color name="light_background">#F0F5F3</color>
    <color name="light_surface">#FFFFFF</color>
    <color name="light_surface_variant">#DCE9E4</color>
    <color name="light_on_surface">#161E1C</color>
    <color name="light_on_surface_variant">#3D524D</color>
    <color name="light_outline">#6F7E7A</color>
    <color name="light_outline_variant">#BEC9C5</color>

    <!-- Dark surfaces -->
    <color name="dark_background">#0C1512</color>
    <color name="dark_surface">#182019</color>
    <color name="dark_surface_variant">#243329</color>
    <color name="dark_on_surface">#DCE9E2</color>
    <color name="dark_on_surface_variant">#8CADA4</color>
    <color name="dark_outline">#899E98</color>
    <color name="dark_outline_variant">#3B504A</color>
    <color name="dark_primary_container">#004E3B</color>
    <color name="dark_on_primary_container">#C0EFE0</color>
    <color name="dark_tertiary_container">#3F3D95</color>
    <color name="dark_on_tertiary_container">#E3E2FF</color>
</resources>
