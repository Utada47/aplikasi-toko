<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="64dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <!-- Top bar: judul besar ala iOS "Large Title" + aksi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wijaya Cell"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <ImageButton
                    android:id="@+id/btnMenuLainnya"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu lainnya (import/export)"
                    android:src="@drawable/ic_more" />

                <ImageButton
                    android:id="@+id/btnToggleTheme"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Ganti tema"
                    android:src="@drawable/ic_theme_toggle" />
            </LinearLayout>

            <!-- Tombol mulai hari (kondisi belum ada sesi terbuka) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMulaiHariIni"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:text="Mulai Buka Hari Ini"
                android:textSize="18sp"
                app:cornerRadius="16dp" />

            <!-- Konten saat sesi sedang berjalan -->
            <LinearLayout
                android:id="@+id/groupSesiAktif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTutupHari"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cornerRadius="14dp"
                    android:text="Tutup Hari" />

                <!-- Section label ala iOS (kapital kecil abu-abu) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="6dp"
                    android:paddingStart="8dp"
                    android:text="BARANG"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:letterSpacing="0.05" />

                <!-- Card rounded berisi tabel Barang -->
                <LinearLayout
                    android:id="@+id/cardBarang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvSubtotalBarang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/ios_blue"
                            tools:text="Rp80.000" />
                    </LinearLayout>

                    <include layout="@layout/row_table_header" android:id="@+id/headerBarang" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBarang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="180dp"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_transaksi_row" />
                </LinearLayout>

                <!-- Section label Transaksi/Pulsa -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="6dp"
                    android:paddingStart="8dp"
                    android:text="TRANSAKSI / PULSA"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:letterSpacing="0.05" />

                <!-- Card rounded berisi tabel Transaksi/Pulsa -->
                <LinearLayout
                    android:id="@+id/cardPulsa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvSubtotalPulsa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/ios_blue"
                            tools:text="Rp70.000" />
                    </LinearLayout>

                    <include layout="@layout/row_table_header" android:id="@+id/headerPulsa" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPulsa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="180dp"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_transaksi_row" />
                </LinearLayout>

                <!-- ruang kosong supaya baris terakhir tabel tidak ketutup FAB tambah -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bar Total Pemasukan: TETAP di paling atas layar, tidak ikut ter-scroll -->
    <LinearLayout
        android:id="@+id/barTotalTetap"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_card_bottom_rounded"
        android:elevation="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total Pemasukan"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="@color/ios_blue"
            tools:text="Rp150.000" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTambah"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Tambah item"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/ios_blue"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
